{
  "branches": {
    "main": {
      "pull_request_required": true,
      "required_approving_review_count": 0,
      "required_status_checks": [
        "Backend checks (ruff, mypy, pyright, legal texts)",
        "Backend coverage (every part, at least 95 %)",
        "Cabinet checks (lint, knip, typecheck, tests with coverage, generated client)",
        "Security (dependencies, secrets, static analysis)",
        "Docker images (build, smoke test, Trivy, SBOM)",
        "End-to-end (1/9)",
        "End-to-end (2/9)",
        "End-to-end (3/9)",
        "End-to-end (4/9)",
        "End-to-end (5/9)",
        "End-to-end (6/9)",
        "End-to-end (7/9)",
        "End-to-end (8/9)",
        "End-to-end (9/9)",
        "Analyze (python)",
        "Analyze (javascript-typescript)",
        "OpenAPI breaking changes (oasdiff)"
      ],
      "force_pushes_blocked": true,
      "deletions_blocked": true
    }
  },
  "private_vulnerability_reporting": true,
  "dependabot_security_updates": true
}
