{
  "collection": "otp_challenges",
  "document_type": "OtpChallengeDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "code_hash": {
        "type": "string"
      },
      "country_code": {
        "anyOf": [
          {
            "maxLength": 2,
            "minLength": 2,
            "pattern": "^[A-Z]{2}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "delivery_channel": {
        "enum": [
          "sms",
          "whatsapp",
          "telegram",
          "email"
        ],
        "type": "string"
      },
      "email": {
        "anyOf": [
          {
            "maxLength": 254,
            "minLength": 6,
            "pattern": "^[a-z0-9._%+\\-]+@[a-z0-9\\-]+(\\.[a-z0-9\\-]+)*\\.([a-z]{2,}|xn--[a-z0-9\\-]+)$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "expires_at": {
        "type": "integer"
      },
      "failed_attempts": {
        "default": 0,
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
      },
      "id": {
        "pattern": "^otp_challenge_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "is_consumed": {
        "default": false,
        "type": "boolean"
      },
      "locale": {
        "maxLength": 16,
        "minLength": 2,
        "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
        "type": "string"
      },
      "login_method": {
        "enum": [
          "phone",
          "email"
        ],
        "type": "string"
      },
      "phone_number": {
        "anyOf": [
          {
            "maxLength": 16,
            "minLength": 8,
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "requested_from_ip": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "login_method",
      "delivery_channel",
      "locale",
      "code_hash",
      "expires_at"
    ],
    "type": "object"
  }
}
