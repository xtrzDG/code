{
  "collection": "billing_profiles",
  "document_type": "BillingProfileDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "address": {
        "anyOf": [
          {
            "maxLength": 400,
            "minLength": 3,
            "pattern": "^[^\\x00-\\x09\\x0b-\\x1f\\x7f]+$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "billing_email": {
        "anyOf": [
          {
            "maxLength": 254,
            "minLength": 6,
            "pattern": "^[a-z0-9._%+\\-]+@[a-z0-9\\-]+(\\.[a-z0-9\\-]+)*\\.([a-z]{2,}|xn--[a-z0-9\\-]+)$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "country_code": {
        "maxLength": 2,
        "minLength": 2,
        "pattern": "^[A-Z]{2}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^billing_profile_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "legal_name": {
        "maxLength": 200,
        "minLength": 2,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "tax_id": {
        "anyOf": [
          {
            "maxLength": 40,
            "minLength": 2,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 ./\\-]*[A-Za-z0-9])?$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "updated_at": {
        "type": "integer"
      },
      "updated_by": {
        "anyOf": [
          {
            "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "id",
      "business_id",
      "legal_name",
      "country_code"
    ],
    "type": "object"
  }
}
