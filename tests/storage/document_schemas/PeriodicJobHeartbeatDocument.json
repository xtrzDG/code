{
  "collection": "periodic_job_heartbeats",
  "document_type": "PeriodicJobHeartbeatDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "created_at": {
        "type": "integer"
      },
      "due_by": {
        "type": "integer"
      },
      "interval_seconds": {
        "maximum": 604800,
        "minimum": 1,
        "type": "integer"
      },
      "job_name": {
        "maxLength": 64,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "lane": {
        "enum": [
          "inbound",
          "outbound",
          "default",
          "autotests",
          "ops"
        ],
        "type": "string"
      },
      "last_succeeded_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "registered_at": {
        "type": "integer"
      },
      "release": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "job_name",
      "interval_seconds",
      "lane",
      "registered_at",
      "due_by"
    ],
    "type": "object"
  }
}
