{
  "collection": "calls",
  "document_type": "CallDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "conversation_id": {
        "anyOf": [
          {
            "pattern": "^conversation_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "cost_micro_usd": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "created_at": {
        "type": "integer"
      },
      "duration_seconds": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "from_phone_number": {
        "anyOf": [
          {
            "maxLength": 16,
            "minLength": 8,
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^call_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "outcome": {
        "anyOf": [
          {
            "enum": [
              "booking",
              "lead",
              "handoff",
              "unanswered_question",
              "information",
              "abandoned"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "provider_call_id": {
        "type": "string"
      },
      "recording_path": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "started_at": {
        "type": "integer"
      },
      "to_phone_number": {
        "anyOf": [
          {
            "maxLength": 16,
            "minLength": 8,
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "transcript": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "business_id",
      "started_at",
      "provider_call_id"
    ],
    "type": "object"
  }
}
