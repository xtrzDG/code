{
  "collection": "platform_pauses",
  "document_type": "PlatformPauseDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "changed_at": {
        "type": "integer"
      },
      "changed_by": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "is_paused": {
        "type": "boolean"
      },
      "reason": {
        "maxLength": 300,
        "minLength": 8,
        "pattern": "^\\S(.*\\S)?$",
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "is_paused",
      "reason",
      "changed_by",
      "changed_at"
    ],
    "type": "object"
  }
}
