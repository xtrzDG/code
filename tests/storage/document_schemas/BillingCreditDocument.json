{
  "collection": "billing_credits",
  "document_type": "BillingCreditDocument",
  "schema_version": 3,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "amount_minor": {
        "maximum": 10000000,
        "minimum": 1,
        "type": "integer"
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "currency_code": {
        "maxLength": 3,
        "minLength": 3,
        "pattern": "^[A-Z]{3}$",
        "type": "string"
      },
      "granted_by": {
        "anyOf": [
          {
            "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^billing_credit_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "invoice_id": {
        "anyOf": [
          {
            "pattern": "^invoice_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "kind": {
        "enum": [
          "granted",
          "used"
        ],
        "type": "string"
      },
      "reason": {
        "anyOf": [
          {
            "maxLength": 300,
            "minLength": 8,
            "pattern": "^\\S[\\s\\S]*\\S$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "referral_of": {
        "anyOf": [
          {
            "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "save_offer_for": {
        "anyOf": [
          {
            "pattern": "^subscription_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "3",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "business_id",
      "kind",
      "amount_minor",
      "currency_code"
    ],
    "type": "object"
  }
}
