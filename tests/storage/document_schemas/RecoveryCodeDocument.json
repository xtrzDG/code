{
  "collection": "recovery_codes",
  "document_type": "RecoveryCodeDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "code_hash": {
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^recovery_code_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      },
      "used_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "user_id": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": [
      "user_id",
      "code_hash"
    ],
    "type": "object"
  }
}
