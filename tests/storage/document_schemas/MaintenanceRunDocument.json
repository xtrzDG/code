{
  "collection": "maintenance_runs",
  "document_type": "MaintenanceRunDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "archive_key": {
        "anyOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[\\x21-\\x7e]+\\Z",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "archive_size": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "finished_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^maintenance_run_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "kind": {
        "enum": [
          "backup",
          "restore_drill"
        ],
        "type": "string"
      },
      "outcome": {
        "enum": [
          "succeeded",
          "failed"
        ],
        "type": "string"
      },
      "release": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "row_count": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "started_at": {
        "type": "integer"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "kind",
      "outcome",
      "started_at",
      "finished_at"
    ],
    "type": "object"
  }
}
