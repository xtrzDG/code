{
  "collection": "audit_log_entries",
  "document_type": "AuditLogEntryDocument",
  "schema_version": 6,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "view",
          "create",
          "update",
          "delete",
          "export",
          "admin_access",
          "login",
          "retention_purge",
          "publish_untested",
          "mfa_changed",
          "support_access_start",
          "support_access_end",
          "session_revoked",
          "platform_admin_changed",
          "spend_limit_reached",
          "admin_trial_extended",
          "admin_discount_given",
          "admin_credit_granted",
          "admin_setup_fee_waived",
          "admin_invoice_marked_paid",
          "admin_plan_overridden"
        ],
        "type": "string"
      },
      "actor_id": {
        "anyOf": [
          {
            "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "business_id": {
        "anyOf": [
          {
            "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "chain_key": {
        "anyOf": [
          {
            "maxLength": 80,
            "minLength": 8,
            "pattern": "^(platform|business_[0-9A-Za-z-]{1,70})$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "chain_position": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "entity": {
        "type": "string"
      },
      "entity_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "entry_hash": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^audit_log_entry_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "ip_address": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "prev_hash": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "reason": {
        "anyOf": [
          {
            "maxLength": 300,
            "minLength": 8,
            "pattern": "^\\S[\\s\\S]*\\S$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "record_count": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "6",
        "type": "string"
      },
      "security_event": {
        "anyOf": [
          {
            "enum": [
              "login_failed",
              "otp_locked",
              "mfa_locked",
              "logout",
              "key_rotation"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "action",
      "entity"
    ],
    "type": "object"
  }
}
