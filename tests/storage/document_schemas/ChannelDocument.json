{
  "collection": "channels",
  "document_type": "ChannelDocument",
  "schema_version": 3,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "credential_checked_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "credential_expires_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "encrypted_secret": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "external_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^channel_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "kind": {
        "enum": [
          "phone",
          "whatsapp",
          "instagram",
          "messenger",
          "telegram",
          "web_chat",
          "viber",
          "owner_test"
        ],
        "type": "string"
      },
      "last_error": {
        "anyOf": [
          {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "last_error_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "public_profile": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "instagram_username": {
                "anyOf": [
                  {
                    "maxLength": 30,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9._]{1,30}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "page_username": {
                "anyOf": [
                  {
                    "maxLength": 50,
                    "minLength": 3,
                    "pattern": "^[A-Za-z0-9.]{3,50}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "whatsapp_number": {
                "anyOf": [
                  {
                    "maxLength": 15,
                    "minLength": 7,
                    "pattern": "^[1-9][0-9]{6,14}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "3",
        "type": "string"
      },
      "status": {
        "default": "pending",
        "enum": [
          "pending",
          "connected",
          "disabled",
          "error"
        ],
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      },
      "web_chat_appearance": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "accent_color": {
                "anyOf": [
                  {
                    "maxLength": 7,
                    "minLength": 7,
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "position": {
                "anyOf": [
                  {
                    "enum": [
                      "left",
                      "right"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "whatsapp_staff_template": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "language_code": {
                "maxLength": 8,
                "minLength": 2,
                "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$",
                "type": "string"
              },
              "name": {
                "maxLength": 512,
                "minLength": 1,
                "pattern": "^[a-z0-9_]{1,512}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "language_code"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "business_id",
      "kind"
    ],
    "type": "object"
  }
}
