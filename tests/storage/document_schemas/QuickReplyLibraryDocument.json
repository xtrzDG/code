{
  "collection": "quick_reply_libraries",
  "document_type": "QuickReplyLibraryDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^quick_reply_library_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "replies": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "created_at": {
              "type": "integer"
            },
            "created_by": {
              "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "id": {
              "pattern": "^quick_reply_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "shortcut": {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[\\w-]+$",
              "type": "string"
            },
            "title": {
              "maxLength": 80,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "updated_at": {
              "type": "integer"
            },
            "variants": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "language": {
                    "maxLength": 16,
                    "minLength": 2,
                    "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
                    "type": "string"
                  },
                  "text": {
                    "maxLength": 2000,
                    "minLength": 1,
                    "pattern": "\\S",
                    "type": "string"
                  }
                },
                "required": [
                  "language",
                  "text"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "shortcut",
            "title",
            "variants",
            "created_by",
            "created_at",
            "updated_at"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "business_id"
    ],
    "type": "object"
  }
}
