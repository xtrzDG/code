{
  "collection": "activation_events",
  "document_type": "ActivationEventDocument",
  "schema_version": 2,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "celebrated_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^activation_event_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "kind": {
        "enum": [
          "test_chat_tried",
          "went_live",
          "first_conversation",
          "first_booking",
          "first_handoff",
          "first_after_hours_booking"
        ],
        "type": "string"
      },
      "occurred_at": {
        "type": "integer"
      },
      "schema_version": {
        "default": "2",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "business_id",
      "kind",
      "occurred_at"
    ],
    "type": "object"
  }
}
