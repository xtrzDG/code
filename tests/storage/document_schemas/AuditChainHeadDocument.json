{
  "collection": "audit_chain_heads",
  "document_type": "AuditChainHeadDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "anyOf": [
          {
            "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "head_hash": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "head_position": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "maxLength": 80,
        "minLength": 8,
        "pattern": "^(platform|business_[0-9A-Za-z-]{1,70})$",
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "head_position",
      "head_hash"
    ],
    "type": "object"
  }
}
