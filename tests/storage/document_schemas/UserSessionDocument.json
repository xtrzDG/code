{
  "collection": "user_sessions",
  "document_type": "UserSessionDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "created_at": {
        "type": "integer"
      },
      "expires_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^user_session_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "token_hash": {
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      },
      "user_id": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": [
      "user_id",
      "token_hash",
      "expires_at"
    ],
    "type": "object"
  }
}
