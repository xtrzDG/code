{
  "collection": "partners",
  "document_type": "PartnerDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "added_by": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "commission_rate_basis_points": {
        "maximum": 5000,
        "minimum": 0,
        "type": "integer"
      },
      "created_at": {
        "type": "integer"
      },
      "email": {
        "anyOf": [
          {
            "maxLength": 254,
            "minLength": 6,
            "pattern": "^[a-z0-9._%+\\-]+@[a-z0-9\\-]+(\\.[a-z0-9\\-]+)*\\.([a-z]{2,}|xn--[a-z0-9\\-]+)$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^partner_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "login_method": {
        "enum": [
          "phone",
          "email"
        ],
        "type": "string"
      },
      "name": {
        "maxLength": 120,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f<>]*\\S[^\\x00-\\x1f\\x7f<>]*$",
        "type": "string"
      },
      "phone_number": {
        "anyOf": [
          {
            "maxLength": 16,
            "minLength": 8,
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "status": {
        "default": "active",
        "enum": [
          "active",
          "paused"
        ],
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "name",
      "login_method",
      "commission_rate_basis_points",
      "added_by"
    ],
    "type": "object"
  }
}
