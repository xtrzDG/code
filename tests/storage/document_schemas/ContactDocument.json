{
  "collection": "contacts",
  "document_type": "ContactDocument",
  "schema_version": 4,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "block": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "blocked_at": {
                "type": "integer"
              },
              "blocked_by": {
                "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "type": "string"
              }
            },
            "required": [
              "blocked_at",
              "blocked_by"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "channel_identities": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "channel": {
              "enum": [
                "phone",
                "whatsapp",
                "instagram",
                "messenger",
                "telegram",
                "web_chat",
                "viber",
                "owner_test"
              ],
              "type": "string"
            },
            "channel_user_id": {
              "type": "string"
            }
          },
          "required": [
            "channel",
            "channel_user_id"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "created_at": {
        "type": "integer"
      },
      "display_name_folded": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "erased_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^contact_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "is_blocked": {
        "default": false,
        "type": "boolean"
      },
      "is_vip": {
        "default": false,
        "type": "boolean"
      },
      "language": {
        "anyOf": [
          {
            "maxLength": 16,
            "minLength": 2,
            "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "last_seen_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "opted_out_channels": {
        "items": {
          "enum": [
            "phone",
            "whatsapp",
            "instagram",
            "messenger",
            "telegram",
            "web_chat",
            "viber",
            "owner_test"
          ],
          "type": "string"
        },
        "type": "array"
      },
      "phone_number": {
        "anyOf": [
          {
            "maxLength": 16,
            "minLength": 8,
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "4",
        "type": "string"
      },
      "tags": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "added_at": {
              "type": "integer"
            },
            "added_by": {
              "anyOf": [
                {
                  "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "key": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]{0,62}[^\\s\\x00-\\x1f\\x7f])?\\Z",
              "type": "string"
            },
            "tag": {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]{0,30}[^\\s\\x00-\\x1f\\x7f])?\\Z",
              "type": "string"
            }
          },
          "required": [
            "tag",
            "key",
            "added_at"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "updated_at": {
        "type": "integer"
      },
      "verified_phone_number": {
        "anyOf": [
          {
            "maxLength": 16,
            "minLength": 8,
            "pattern": "^\\+[1-9][0-9]{6,14}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "business_id"
    ],
    "type": "object"
  }
}
