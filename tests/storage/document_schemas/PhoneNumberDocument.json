{
  "collection": "phone_numbers",
  "document_type": "PhoneNumberDocument",
  "schema_version": 2,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "attached_agent_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "billed_until": {
        "type": "integer"
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "country_code": {
        "maxLength": 2,
        "minLength": 2,
        "pattern": "^[A-Z]{2}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "currency_code": {
        "maxLength": 3,
        "minLength": 3,
        "pattern": "^[A-Z]{3}$",
        "type": "string"
      },
      "id": {
        "pattern": "^phone_number_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "locality": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "monthly_cost_micro_usd": {
        "minimum": 0,
        "type": "integer"
      },
      "monthly_price_minor": {
        "maximum": 10000000,
        "minimum": 1,
        "type": "integer"
      },
      "number_type": {
        "enum": [
          "local",
          "mobile",
          "toll_free"
        ],
        "type": "string"
      },
      "phone_number": {
        "maxLength": 16,
        "minLength": 8,
        "pattern": "^\\+[1-9][0-9]{6,14}$",
        "type": "string"
      },
      "provider": {
        "enum": [
          "twilio"
        ],
        "type": "string"
      },
      "provider_number_id": {
        "type": "string"
      },
      "release_reason": {
        "anyOf": [
          {
            "enum": [
              "owner",
              "unpaid"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "release_requested_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "released_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "rented_at": {
        "type": "integer"
      },
      "rented_by": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "schema_version": {
        "default": "2",
        "type": "string"
      },
      "status": {
        "default": "active",
        "enum": [
          "active",
          "releasing",
          "released"
        ],
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      },
      "voice_fallback_url": {
        "anyOf": [
          {
            "maxLength": 2048,
            "minLength": 12,
            "pattern": "^https?://[^\\s/]+(/[^\\s]*)?$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "voice_platform_number_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "business_id",
      "provider",
      "provider_number_id",
      "phone_number",
      "country_code",
      "number_type",
      "monthly_price_minor",
      "currency_code",
      "monthly_cost_micro_usd",
      "rented_by",
      "rented_at",
      "billed_until"
    ],
    "type": "object"
  }
}
