{
  "collection": "mfa_challenges",
  "document_type": "MfaChallengeDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "created_at": {
        "type": "integer"
      },
      "expires_at": {
        "type": "integer"
      },
      "failed_attempts": {
        "default": 0,
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
      },
      "id": {
        "pattern": "^mfa_challenge_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "is_consumed": {
        "default": false,
        "type": "boolean"
      },
      "is_new_user": {
        "default": false,
        "type": "boolean"
      },
      "requested_from_ip": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      },
      "user_id": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": [
      "user_id",
      "expires_at"
    ],
    "type": "object"
  }
}
