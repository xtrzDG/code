{
  "collection": "subscriptions",
  "document_type": "SubscriptionDocument",
  "schema_version": 4,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "billing_period": {
        "enum": [
          "monthly",
          "annual"
        ],
        "type": "string"
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "currency_code": {
        "maxLength": 3,
        "minLength": 3,
        "pattern": "^[A-Z]{3}$",
        "type": "string"
      },
      "discount": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "ends_at": {
                "type": "integer"
              },
              "granted_at": {
                "type": "integer"
              },
              "granted_by": {
                "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "type": "string"
              },
              "percent": {
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "percent",
              "ends_at",
              "granted_by",
              "granted_at"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "grace_until": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^subscription_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "is_setup_fee_waived": {
        "default": false,
        "type": "boolean"
      },
      "pause_starts_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "pause_until": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "period_end": {
        "type": "integer"
      },
      "period_start": {
        "type": "integer"
      },
      "plan_key": {
        "enum": [
          "chat",
          "voice_and_chat",
          "plus"
        ],
        "type": "string"
      },
      "price_minor": {
        "minimum": 0,
        "type": "integer"
      },
      "provider_reference": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "4",
        "type": "string"
      },
      "setup_option": {
        "anyOf": [
          {
            "enum": [
              "self_serve",
              "done_for_you"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "status": {
        "enum": [
          "incomplete",
          "trialing",
          "active",
          "past_due",
          "cancelled",
          "paused"
        ],
        "type": "string"
      },
      "trial_ends_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "business_id",
      "plan_key",
      "billing_period",
      "price_minor",
      "currency_code",
      "status",
      "period_start",
      "period_end"
    ],
    "type": "object"
  }
}
