{
  "collection": "leads",
  "document_type": "LeadDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "budget": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "contact_id": {
        "pattern": "^contact_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "conversation_id": {
        "anyOf": [
          {
            "pattern": "^conversation_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "details": {
        "type": "string"
      },
      "id": {
        "pattern": "^lead_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "is_sandbox": {
        "default": false,
        "type": "boolean"
      },
      "lead_type": {
        "enum": [
          "banquet",
          "group",
          "corporate",
          "order",
          "viewing",
          "other"
        ],
        "type": "string"
      },
      "party_size": {
        "anyOf": [
          {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "requested_date": {
        "anyOf": [
          {
            "maxLength": 10,
            "minLength": 10,
            "pattern": "^(19|20|21)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "source_channel": {
        "enum": [
          "phone",
          "whatsapp",
          "instagram",
          "messenger",
          "telegram",
          "web_chat",
          "viber",
          "owner_test"
        ],
        "type": "string"
      },
      "status": {
        "default": "new",
        "enum": [
          "new",
          "in_progress",
          "won",
          "lost"
        ],
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "business_id",
      "contact_id",
      "lead_type",
      "details",
      "source_channel"
    ],
    "type": "object"
  }
}
