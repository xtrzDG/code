{
  "collection": "subprocessor_notices",
  "document_type": "SubprocessorNoticeDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "change_key": {
        "maxLength": 80,
        "minLength": 16,
        "pattern": "^[a-z][a-z0-9_]*-(added|removed)-[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "effective_on": {
        "maxLength": 10,
        "minLength": 10,
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
        "type": "string"
      },
      "id": {
        "pattern": "^subprocessor_notice_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "is_late": {
        "default": false,
        "type": "boolean"
      },
      "kind": {
        "enum": [
          "added",
          "removed"
        ],
        "type": "string"
      },
      "notified_at": {
        "type": "integer"
      },
      "recipient_count": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "subprocessor": {
        "maxLength": 40,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "business_id",
      "change_key",
      "kind",
      "subprocessor",
      "effective_on",
      "recipient_count",
      "notified_at"
    ],
    "type": "object"
  }
}
