{
  "collection": "business_privacy_settings",
  "document_type": "BusinessPrivacySettingsDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "conversation_retention_days": {
        "default": 730,
        "maximum": 3650,
        "minimum": 30,
        "type": "integer"
      },
      "created_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^privacy_settings_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "llm_turn_retention_days": {
        "default": 30,
        "maximum": 30,
        "minimum": 1,
        "type": "integer"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "business_id"
    ],
    "type": "object"
  }
}
