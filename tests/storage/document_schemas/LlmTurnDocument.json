{
  "collection": "llm_turns",
  "document_type": "LlmTurnDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "conversation_id": {
        "pattern": "^conversation_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^llm_turn_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "payload": {
        "type": "string"
      },
      "role": {
        "enum": [
          "user",
          "assistant"
        ],
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "sequence_number": {
        "minimum": 0,
        "type": "integer"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "conversation_id",
      "sequence_number",
      "role",
      "payload"
    ],
    "type": "object"
  }
}
