{
  "collection": "meta_connection_states",
  "document_type": "MetaConnectionStateDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "encrypted_user_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "expires_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^meta_connection_state_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "is_consumed": {
        "default": false,
        "type": "boolean"
      },
      "purpose": {
        "enum": [
          "whatsapp",
          "pages"
        ],
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "state_hash": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      },
      "user_id": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": [
      "business_id",
      "user_id",
      "purpose",
      "state_hash",
      "expires_at"
    ],
    "type": "object"
  }
}
