{
  "collection": "staff_delivery_states",
  "document_type": "StaffDeliveryStateDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "attempted_at": {
        "type": "integer"
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "delivered_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^staff_delivery_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "last_error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "status": {
        "enum": [
          "pending",
          "delivered",
          "dead"
        ],
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "business_id",
      "status",
      "attempted_at"
    ],
    "type": "object"
  }
}
