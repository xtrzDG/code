{
  "collection": "security_nudges",
  "document_type": "SecurityNudgeDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "dismissed_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^security_nudge_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "team_size_at_dismissal": {
        "maximum": 100000,
        "minimum": 0,
        "type": "integer"
      },
      "updated_at": {
        "type": "integer"
      },
      "user_id": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": [
      "id",
      "business_id",
      "user_id",
      "dismissed_at",
      "team_size_at_dismissal"
    ],
    "type": "object"
  }
}
