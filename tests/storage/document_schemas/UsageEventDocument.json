{
  "collection": "usage_events",
  "document_type": "UsageEventDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "conversation_id": {
        "anyOf": [
          {
            "pattern": "^conversation_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "cost_micro_usd": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "created_at": {
        "type": "integer"
      },
      "id": {
        "pattern": "^usage_event_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "kind": {
        "enum": [
          "voice_seconds",
          "llm_input_tokens",
          "llm_output_tokens",
          "dialog",
          "whatsapp_reply",
          "whatsapp_template",
          "transfer_seconds"
        ],
        "type": "string"
      },
      "occurred_at": {
        "type": "integer"
      },
      "quantity": {
        "minimum": 0,
        "type": "integer"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "business_id",
      "kind",
      "quantity",
      "occurred_at"
    ],
    "type": "object"
  }
}
