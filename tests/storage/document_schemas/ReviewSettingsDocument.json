{
  "collection": "review_settings",
  "document_type": "ReviewSettingsDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "delay_minutes": {
        "default": 120,
        "maximum": 4320,
        "minimum": 15,
        "type": "integer"
      },
      "feedback_template_name": {
        "anyOf": [
          {
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[a-z0-9_]{1,512}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^review_settings_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "is_feedback_enabled": {
        "default": false,
        "type": "boolean"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "business_id"
    ],
    "type": "object"
  }
}
