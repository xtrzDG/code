{
  "collection": "push_subscriptions",
  "document_type": "PushSubscriptionDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "delivered_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "endpoint": {
        "maxLength": 2048,
        "minLength": 12,
        "pattern": "^https://[^\\s]+$",
        "type": "string"
      },
      "id": {
        "pattern": "^push_subscription_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "keys": {
        "additionalProperties": false,
        "properties": {
          "auth": {
            "maxLength": 64,
            "minLength": 16,
            "pattern": "^[A-Za-z0-9_-]+={0,2}$",
            "type": "string"
          },
          "p256dh": {
            "maxLength": 100,
            "minLength": 80,
            "pattern": "^[A-Za-z0-9_-]+={0,2}$",
            "type": "string"
          }
        },
        "required": [
          "p256dh",
          "auth"
        ],
        "type": "object"
      },
      "language": {
        "maxLength": 16,
        "minLength": 2,
        "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
        "type": "string"
      },
      "last_error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      },
      "user_id": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": [
      "id",
      "business_id",
      "user_id",
      "endpoint",
      "keys",
      "language"
    ],
    "type": "object"
  }
}
