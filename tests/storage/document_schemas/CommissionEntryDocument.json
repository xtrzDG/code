{
  "collection": "commission_entries",
  "document_type": "CommissionEntryDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "accrued_at": {
        "type": "integer"
      },
      "amount_minor": {
        "minimum": 0,
        "type": "integer"
      },
      "base_minor": {
        "minimum": 0,
        "type": "integer"
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "currency_code": {
        "maxLength": 3,
        "minLength": 3,
        "pattern": "^[A-Z]{3}$",
        "type": "string"
      },
      "id": {
        "pattern": "^commission_entry_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "invoice_id": {
        "pattern": "^invoice_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "month": {
        "maxLength": 7,
        "minLength": 7,
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
        "type": "string"
      },
      "paid_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "paid_by": {
        "anyOf": [
          {
            "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "partner_id": {
        "pattern": "^partner_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "payout_reference": {
        "anyOf": [
          {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f<>]*\\S[^\\x00-\\x1f\\x7f<>]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "rate_basis_points": {
        "maximum": 5000,
        "minimum": 0,
        "type": "integer"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "status": {
        "default": "accrued",
        "enum": [
          "accrued",
          "paid"
        ],
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "partner_id",
      "business_id",
      "invoice_id",
      "base_minor",
      "rate_basis_points",
      "amount_minor",
      "currency_code",
      "accrued_at",
      "month"
    ],
    "type": "object"
  }
}
