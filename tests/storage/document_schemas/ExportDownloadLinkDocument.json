{
  "collection": "export_download_links",
  "document_type": "ExportDownloadLinkDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "expires_at": {
        "type": "integer"
      },
      "export_id": {
        "pattern": "^business_export_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "id": {
        "pattern": "^export_download_link_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "token_hash": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      },
      "used_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "user_id": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": [
      "id",
      "business_id",
      "export_id",
      "user_id",
      "token_hash",
      "expires_at"
    ],
    "type": "object"
  }
}
