{
  "collection": "payment_retry_attempts",
  "document_type": "PaymentRetryAttemptDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "amount_minor": {
        "minimum": 0,
        "type": "integer"
      },
      "attempt": {
        "maximum": 3,
        "minimum": 1,
        "type": "integer"
      },
      "attempted_at": {
        "type": "integer"
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "currency_code": {
        "maxLength": 3,
        "minLength": 3,
        "pattern": "^[A-Z]{3}$",
        "type": "string"
      },
      "due_at": {
        "type": "integer"
      },
      "failure_reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^payment_retry_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "invoice_id": {
        "pattern": "^invoice_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "outcome": {
        "default": "claimed",
        "enum": [
          "claimed",
          "approved",
          "declined",
          "processing",
          "failed",
          "not_possible",
          "skipped"
        ],
        "type": "string"
      },
      "payment_reference": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "provider": {
        "enum": [
          "flitt",
          "stripe"
        ],
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "subscription_id": {
        "pattern": "^subscription_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "business_id",
      "subscription_id",
      "invoice_id",
      "attempt",
      "provider",
      "amount_minor",
      "currency_code",
      "due_at",
      "attempted_at"
    ],
    "type": "object"
  }
}
