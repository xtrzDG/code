{
  "collection": "queued_jobs",
  "document_type": "QueuedJobDocument",
  "schema_version": 2,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "attempts": {
        "default": 0,
        "maximum": 1000,
        "minimum": 0,
        "type": "integer"
      },
      "business_id": {
        "anyOf": [
          {
            "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "dead_reason": {
        "anyOf": [
          {
            "enum": [
              "attempts_exhausted",
              "process_died",
              "no_handler"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^queued_job_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "lane": {
        "default": "default",
        "enum": [
          "inbound",
          "outbound",
          "default",
          "autotests"
        ],
        "type": "string"
      },
      "last_error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "lease_token": {
        "anyOf": [
          {
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[0-9a-f]{32}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "lease_until": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "lost_leases": {
        "default": 0,
        "maximum": 1000,
        "minimum": 0,
        "type": "integer"
      },
      "name": {
        "maxLength": 64,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "payload": {
        "type": "string"
      },
      "run_at": {
        "type": "integer"
      },
      "schema_version": {
        "default": "2",
        "type": "string"
      },
      "serial_key": {
        "anyOf": [
          {
            "maxLength": 200,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9_.:\\-]+$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "status": {
        "default": "pending",
        "enum": [
          "pending",
          "running",
          "done",
          "dead",
          "discarded"
        ],
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "name",
      "payload",
      "run_at"
    ],
    "type": "object"
  }
}
