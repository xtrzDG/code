{
  "collection": "data_task_states",
  "document_type": "DataTaskStateDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "batch_count": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "changed_count": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "collection_name": {
        "maxLength": 63,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_]{1,62}\\Z",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "failed_document_keys": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "failed_row_count": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "failure_count": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "field": {
        "anyOf": [
          {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]{0,47}(\\[\\]\\.[a-z][a-z0-9_]{0,47})?\\Z",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "finished_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "key": {
        "maxLength": 140,
        "minLength": 20,
        "pattern": "^(migrate_documents:[a-z][a-z0-9_]{1,62}|backfill_lookup:[a-z][a-z0-9_]{1,62}\\.[a-z][a-z0-9_]{0,58})\\Z",
        "type": "string"
      },
      "kind": {
        "enum": [
          "migrate_documents",
          "backfill_lookup"
        ],
        "type": "string"
      },
      "last_batch_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "last_error": {
        "anyOf": [
          {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "pending_since": {
        "type": "integer"
      },
      "position": {
        "anyOf": [
          {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "release": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "scanned_count": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "started_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "status": {
        "enum": [
          "pending",
          "running",
          "done",
          "failed"
        ],
        "type": "string"
      },
      "target_version": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "key",
      "kind",
      "collection_name",
      "status",
      "pending_since"
    ],
    "type": "object"
  }
}
