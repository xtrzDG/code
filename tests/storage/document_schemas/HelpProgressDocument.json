{
  "collection": "help_progress",
  "document_type": "HelpProgressDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "changelog_read_key": {
        "anyOf": [
          {
            "maxLength": 80,
            "minLength": 10,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(-[a-z0-9]+)*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "seen_coach_marks": {
        "items": {
          "maxLength": 40,
          "minLength": 2,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "type": "array"
      },
      "updated_at": {
        "type": "integer"
      },
      "user_id": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": [
      "user_id"
    ],
    "type": "object"
  }
}
