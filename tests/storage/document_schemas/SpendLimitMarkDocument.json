{
  "collection": "spend_limit_marks",
  "document_type": "SpendLimitMarkDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "day": {
        "maxLength": 10,
        "minLength": 10,
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "id": {
        "pattern": "^spend_limit_mark_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "level": {
        "enum": [
          "normal",
          "soft_limit",
          "hard_limit"
        ],
        "type": "string"
      },
      "limit_micro_usd": {
        "minimum": 0,
        "type": "integer"
      },
      "reached_at": {
        "type": "integer"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "spend_micro_usd": {
        "minimum": 0,
        "type": "integer"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "business_id",
      "day",
      "level",
      "spend_micro_usd",
      "limit_micro_usd",
      "reached_at"
    ],
    "type": "object"
  }
}
