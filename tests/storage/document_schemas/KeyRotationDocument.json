{
  "collection": "key_rotations",
  "document_type": "KeyRotationDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "created_at": {
        "type": "integer"
      },
      "finished_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^key_rotation_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "key_count": {
        "maximum": 32,
        "minimum": 1,
        "type": "integer"
      },
      "last_error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "requested_by": {
        "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "secrets_current": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "secrets_rotated": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "secrets_total": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "secrets_unreadable": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "started_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "status": {
        "default": "queued",
        "enum": [
          "queued",
          "running",
          "done",
          "failed"
        ],
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      },
      "webhooks_failed": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "webhooks_renewed": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "requested_by",
      "key_count"
    ],
    "type": "object"
  }
}
