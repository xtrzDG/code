{
  "collection": "waitlist_entries",
  "document_type": "WaitlistEntryDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "booked_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "booking_id": {
        "anyOf": [
          {
            "pattern": "^booking_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "contact_id": {
        "pattern": "^contact_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "contact_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "conversation_id": {
        "anyOf": [
          {
            "pattern": "^conversation_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "date": {
        "maxLength": 10,
        "minLength": 10,
        "pattern": "^(19|20|21)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
        "type": "string"
      },
      "end_reason": {
        "anyOf": [
          {
            "enum": [
              "declined",
              "no_answer",
              "date_passed",
              "unreachable",
              "removed"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "ended_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "ended_by": {
        "anyOf": [
          {
            "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^waitlist_entry_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "is_sandbox": {
        "default": false,
        "type": "boolean"
      },
      "language": {
        "maxLength": 16,
        "minLength": 2,
        "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
        "type": "string"
      },
      "nights": {
        "anyOf": [
          {
            "maximum": 365,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "notes": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "offer": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "buffer_minutes": {
                "anyOf": [
                  {
                    "maximum": 240,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "channel": {
                "anyOf": [
                  {
                    "enum": [
                      "phone",
                      "whatsapp",
                      "instagram",
                      "messenger",
                      "telegram",
                      "web_chat",
                      "viber",
                      "owner_test"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "conversation_id": {
                "anyOf": [
                  {
                    "pattern": "^conversation_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "currency_code": {
                "anyOf": [
                  {
                    "maxLength": 3,
                    "minLength": 3,
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "ends_at": {
                "minimum": 0,
                "type": "integer"
              },
              "freed_booking_id": {
                "pattern": "^booking_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "type": "string"
              },
              "offered_at": {
                "type": "integer"
              },
              "outbound_message_id": {
                "anyOf": [
                  {
                    "pattern": "^outbound_message_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "resource_id": {
                "pattern": "^resource_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "type": "string"
              },
              "service_item_id": {
                "anyOf": [
                  {
                    "pattern": "^knowledge_item_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "starts_at": {
                "minimum": 0,
                "type": "integer"
              },
              "value_minor": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "freed_booking_id",
              "resource_id",
              "starts_at",
              "ends_at",
              "offered_at"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "offer_count": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "offer_expires_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "party_size": {
        "maximum": 10000,
        "minimum": 1,
        "type": "integer"
      },
      "resource_id": {
        "anyOf": [
          {
            "pattern": "^resource_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "resource_kind": {
        "anyOf": [
          {
            "enum": [
              "table",
              "room",
              "staff",
              "arena",
              "bay",
              "vehicle",
              "slot"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "service_item_id": {
        "anyOf": [
          {
            "pattern": "^knowledge_item_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "source_channel": {
        "enum": [
          "phone",
          "whatsapp",
          "instagram",
          "messenger",
          "telegram",
          "web_chat",
          "viber",
          "owner_test"
        ],
        "type": "string"
      },
      "status": {
        "default": "waiting",
        "enum": [
          "waiting",
          "offered",
          "booked",
          "expired"
        ],
        "type": "string"
      },
      "time_from": {
        "anyOf": [
          {
            "maxLength": 5,
            "minLength": 5,
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "time_to": {
        "anyOf": [
          {
            "maxLength": 5,
            "minLength": 5,
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "updated_at": {
        "type": "integer"
      },
      "waits_until": {
        "type": "integer"
      }
    },
    "required": [
      "business_id",
      "contact_id",
      "source_channel",
      "language",
      "date",
      "party_size",
      "waits_until"
    ],
    "type": "object"
  }
}
