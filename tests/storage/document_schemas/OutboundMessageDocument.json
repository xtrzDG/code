{
  "collection": "outbound_messages",
  "document_type": "OutboundMessageDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "attempts": {
        "default": 0,
        "maximum": 1000,
        "minimum": 0,
        "type": "integer"
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "conversation_id": {
        "anyOf": [
          {
            "pattern": "^conversation_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "customer": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "channel": {
                "enum": [
                  "phone",
                  "whatsapp",
                  "instagram",
                  "messenger",
                  "telegram",
                  "web_chat",
                  "viber",
                  "owner_test"
                ],
                "type": "string"
              },
              "channel_id": {
                "pattern": "^channel_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "type": "string"
              },
              "channel_user_id": {
                "type": "string"
              }
            },
            "required": [
              "channel_id",
              "channel",
              "channel_user_id"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "delivered_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "delivered_parts": {
        "default": 0,
        "maximum": 1000,
        "minimum": 0,
        "type": "integer"
      },
      "handoff_id": {
        "anyOf": [
          {
            "pattern": "^handoff_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^outbound_message_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "idempotency_key": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "kind": {
        "enum": [
          "customer_reply",
          "staff_notification"
        ],
        "type": "string"
      },
      "last_error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "next_attempt_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "provider_message_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "recipient_key": {
        "maxLength": 400,
        "minLength": 1,
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "source_message_id": {
        "anyOf": [
          {
            "pattern": "^message_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "staff_contact": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "address": {
                "type": "string"
              },
              "channel": {
                "enum": [
                  "telegram",
                  "whatsapp",
                  "email",
                  "sms"
                ],
                "type": "string"
              },
              "language": {
                "maxLength": 16,
                "minLength": 2,
                "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "channel",
              "address",
              "language"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "status": {
        "default": "pending",
        "enum": [
          "pending",
          "delivered",
          "dead"
        ],
        "type": "string"
      },
      "template": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "language_code": {
                "maxLength": 8,
                "minLength": 2,
                "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$",
                "type": "string"
              },
              "name": {
                "maxLength": 512,
                "minLength": 1,
                "pattern": "^[a-z0-9_]{1,512}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "language_code"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "text": {
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "business_id",
      "kind",
      "idempotency_key",
      "recipient_key",
      "text"
    ],
    "type": "object"
  }
}
