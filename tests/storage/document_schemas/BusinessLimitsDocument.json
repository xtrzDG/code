{
  "collection": "business_limits",
  "document_type": "BusinessLimitsDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "daily_hard_limit_micro_usd": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "daily_soft_limit_micro_usd": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^business_limits_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      },
      "widget_allowed_origins": {
        "items": {
          "maxLength": 2048,
          "minLength": 10,
          "pattern": "^https?://[^\\s/]+(/[^\\s]*)?$",
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "id",
      "business_id"
    ],
    "type": "object"
  }
}
