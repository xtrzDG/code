{
  "collection": "business_deletions",
  "document_type": "BusinessDeletionDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_name": {
        "type": "string"
      },
      "certificate_digest": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}\\Z",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "completed_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "created_at": {
        "type": "integer"
      },
      "deleted_business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "deprovisioned": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "item_count": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            },
            "outcome": {
              "enum": [
                "done",
                "nothing",
                "skipped"
              ],
              "type": "string"
            },
            "target": {
              "enum": [
                "voice_agent",
                "telegram_webhook",
                "meta_subscription",
                "google_calendar",
                "phone_number",
                "payment_schedule"
              ],
              "type": "string"
            }
          },
          "required": [
            "target",
            "outcome"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "deprovisioned_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "erased_files": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "erased_rows": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "collection": {
              "maxLength": 63,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_]{1,62}\\Z",
              "type": "string"
            },
            "row_count": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "collection",
            "row_count"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "files_erased_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^business_deletion_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "jobs_cleared_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "owners": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "user_id": {
              "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "required": [
            "user_id"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "processor_erasure_jobs": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "reason": {
        "enum": [
          "owner_request",
          "unpaid_subscription"
        ],
        "type": "string"
      },
      "requested_at": {
        "type": "integer"
      },
      "requested_by": {
        "anyOf": [
          {
            "pattern": "^user_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "retained_rows": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "collection": {
              "maxLength": 63,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_]{1,62}\\Z",
              "type": "string"
            },
            "row_count": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "collection",
            "row_count"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "rows_counted_at": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "started_at": {
        "type": "integer"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "id",
      "deleted_business_id",
      "business_name",
      "reason",
      "requested_at",
      "started_at"
    ],
    "type": "object"
  }
}
