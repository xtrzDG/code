      "skipped_after_launch": {
        "items": {
          "enum": [
            "business",
            "offer",
            "hours_and_bookings",
            "staff_contact",
            "channels",
            "test",
            "launch",
            "phone_test",
            "second_channel",
            "share"
          ],
          "type": "string"
