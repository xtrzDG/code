{
  "collection": "public_slug_claims",
  "document_type": "PublicSlugClaimDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "slug": {
        "maxLength": 40,
        "minLength": 3,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "business_id",
      "slug"
    ],
    "type": "object"
  }
}
