{
  "collection": "knowledge_items",
  "document_type": "KnowledgeItemDocument",
  "schema_version": 1,
  "shape": {
    "additionalProperties": false,
    "properties": {
      "attributes": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "key": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "value"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "body": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "business_id": {
        "pattern": "^business_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "created_at": {
        "type": "integer"
      },
      "currency_code": {
        "anyOf": [
          {
            "maxLength": 3,
            "minLength": 3,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "duration_minutes": {
        "anyOf": [
          {
            "maximum": 43200,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "pattern": "^knowledge_item_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "import_batch_id": {
        "anyOf": [
          {
            "pattern": "^menu_import_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "is_active": {
        "default": true,
        "type": "boolean"
      },
      "kind": {
        "enum": [
          "faq",
          "policy",
          "menu_item",
          "service",
          "room_type",
          "package",
          "vehicle",
          "product"
        ],
        "type": "string"
      },
      "languages": {
        "items": {
          "maxLength": 16,
          "minLength": 2,
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
          "type": "string"
        },
        "type": "array"
      },
      "price_minor": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "schema_version": {
        "default": "1",
        "type": "string"
      },
      "source": {
        "default": "owner",
        "enum": [
          "profile",
          "owner",
          "unanswered_question",
          "menu_import"
        ],
        "type": "string"
      },
      "tags": {
        "items": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "type": "string"
        },
        "type": "array"
      },
      "title": {
        "type": "string"
      },
      "updated_at": {
        "type": "integer"
      }
    },
    "required": [
      "business_id",
      "kind",
      "title"
    ],
    "type": "object"
  }
}
