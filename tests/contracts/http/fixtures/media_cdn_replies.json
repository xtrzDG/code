{
  "source": "What the messaging platforms' file servers answer a download: Meta's media URL (lookaside.fbsbx.com; valid five minutes, Bearer token required) and the Telegram Bot API file path (api.telegram.org/file/bot<token>/<file_path>, valid one hour). Expected is the error the media worker receives (null: downloaded).",
  "cases": [
    {
      "id": "meta-image",
      "status": 200,
      "headers": {"Content-Type": "image/jpeg", "Content-Length": "4"},
      "body": "ÿØÿà",
      "expected": null
    },
    {
      "id": "meta-url-expired",
      "status": 404,
      "headers": {"Content-Type": "text/html; charset=utf-8"},
      "body": "URL signature expired",
      "expected": "MediaUnavailableError"
    },
    {
      "id": "meta-no-token",
      "status": 401,
      "headers": {"Content-Type": "application/json", "WWW-Authenticate": "OAuth \"Facebook Platform\" \"invalid_token\""},
      "body": "{\"error\":{\"message\":\"Invalid OAuth access token.\",\"type\":\"OAuthException\",\"code\":190}}",
      "expected": "MediaUnavailableError"
    },
    {
      "id": "telegram-file-path-expired",
      "status": 404,
      "headers": {"Content-Type": "application/json"},
      "body": "{\"ok\":false,\"error_code\":404,\"description\":\"Not Found\"}",
      "expected": "MediaUnavailableError"
    },
    {
      "id": "declared-too-large",
      "status": 200,
      "headers": {"Content-Type": "audio/ogg", "Content-Length": "26214401"},
      "body": "",
      "expected": "MediaTooLargeError"
    },
    {
      "id": "cdn-bad-gateway",
      "status": 502,
      "headers": {"Content-Type": "text/html"},
      "body": "<html><body>502 Bad Gateway</body></html>",
      "expected": "ExternalServiceError"
    }
  ]
}
