{
  "source": "RFC 9110 (8.3.1 media types, 8.4 Content-Encoding, 10.2.2 Location), RFC 9112 (7.1 chunked coding) and the answers of the hosts small-business sites run on (nginx, Cloudflare, Tilda, Wix). Each case is one raw HTTP/1.1 answer; `then` follows a redirect. A body marked gzip is compressed by the test. Content-Length is added by the test from the body.",
  "cases": [
    {
      "id": "rfc9110-content-type-plain",
      "head": [
        "HTTP/1.1 200 OK",
        "Content-Type: text/html;charset=utf-8"
      ],
      "body": "<p>Khachapuri 18₾</p>",
      "expected": {
        "media_type": "text/html",
        "charset": "utf-8"
      }
    },
    {
      "id": "rfc9110-content-type-mixed-case-quoted",
      "head": [
        "HTTP/1.1 200 OK",
        "Content-Type: Text/HTML;Charset=\"utf-8\""
      ],
      "body": "<p>Khachapuri 18₾</p>",
      "expected": {
        "media_type": "text/html",
        "charset": "utf-8"
      }
    },
    {
      "id": "rfc9110-content-type-spaced-quoted",
      "head": [
        "HTTP/1.1 200 OK",
        "Content-Type: text/html; charset=\"utf-8\""
      ],
      "body": "<p>Khachapuri 18₾</p>",
      "expected": {
        "media_type": "text/html",
        "charset": "utf-8"
      }
    },
    {
      "id": "windows-1251-site",
      "head": [
        "HTTP/1.1 200 OK",
        "Server: Apache",
        "Content-Type: text/html; charset=windows-1251"
      ],
      "body": "<p>ok</p>",
      "expected": {
        "media_type": "text/html",
        "charset": "windows-1251"
      }
    },
    {
      "id": "no-content-type",
      "head": [
        "HTTP/1.1 200 OK"
      ],
      "body": "<p>ok</p>",
      "expected": {
        "media_type": "text/html",
        "charset": null
      }
    },
    {
      "id": "nginx-gzip-chunked-despite-identity",
      "head": [
        "HTTP/1.1 200 OK",
        "Server: nginx",
        "Content-Type: text/html; charset=UTF-8",
        "Transfer-Encoding: chunked",
        "Connection: keep-alive",
        "Vary: Accept-Encoding",
        "Content-Encoding: gzip"
      ],
      "gzip_chunked_body": "<html><body><h1>Menu</h1><p>Khinkali 1.20₾</p></body></html>",
      "expected": {
        "media_type": "text/html",
        "charset": "utf-8",
        "body": "<html><body><h1>Menu</h1><p>Khinkali 1.20₾</p></body></html>"
      }
    },
    {
      "id": "rfc9112-chunk-extensions-and-trailer",
      "head": [
        "HTTP/1.1 200 OK",
        "Content-Type: text/plain; charset=us-ascii",
        "Transfer-Encoding: chunked",
        "Trailer: Expires"
      ],
      "raw_body": "7;name=value\r\nOpen 9-\r\n4\r\n21 h\r\n0\r\nExpires: Wed, 21 Oct 2026 07:28:00 GMT\r\n\r\n",
      "expected": {
        "media_type": "text/plain",
        "charset": "us-ascii",
        "body": "Open 9-21 h"
      }
    },
    {
      "id": "cloudflare-brotli",
      "head": [
        "HTTP/1.1 200 OK",
        "Server: cloudflare",
        "Content-Type: text/html; charset=utf-8",
        "Content-Encoding: br",
        "CF-RAY: 8d3c1a2b3c4d5e6f-TBS"
      ],
      "body": "\u001b\u0003\u0000\u0000",
      "expected": {
        "detail": "content_encoding:br"
      }
    },
    {
      "id": "tilda-relative-redirect",
      "head": [
        "HTTP/1.1 301 Moved Permanently",
        "Server: nginx",
        "Content-Type: text/html",
        "Location: /menu"
      ],
      "body": "",
      "then": {
        "head": [
          "HTTP/1.1 200 OK",
          "Content-Type: text/html; charset=UTF-8"
        ],
        "body": "<p>ok</p>"
      },
      "expected": {
        "media_type": "text/html",
        "charset": "utf-8",
        "final_url": "https://cafe.example/menu"
      }
    },
    {
      "id": "wix-permanent-redirect",
      "head": [
        "HTTP/1.1 308 Permanent Redirect",
        "Location: https://cafe.example/en"
      ],
      "body": "",
      "then": {
        "head": [
          "HTTP/1.1 200 OK",
          "Content-Type: text/html; charset=UTF-8"
        ],
        "body": "<p>ok</p>"
      },
      "expected": {
        "media_type": "text/html",
        "charset": "utf-8",
        "final_url": "https://cafe.example/en"
      }
    },
    {
      "id": "xhtml-not-requested",
      "head": [
        "HTTP/1.1 200 OK",
        "Content-Type: application/xhtml+xml; charset=utf-8"
      ],
      "body": "<p>ok</p>",
      "expected": {
        "detail": "media_type:application/xhtml+xml"
      }
    },
    {
      "id": "gone",
      "head": [
        "HTTP/1.1 410 Gone",
        "Content-Type: text/html"
      ],
      "body": "",
      "expected": {
        "detail": "http_status:410"
      }
    }
  ]
}
