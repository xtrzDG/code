{
 "$comment": "Written from Cloudflare's Turnstile server-side validation page; Cloudflare publishes no machine-readable specification of siteverify. Review against the page in x-vendor.docs when Cloudflare announces changes.",
 "$defs": {
  "request:siteverify": {
   "properties": {
    "idempotency_key": {
     "format": "uuid",
     "type": "string"
    },
    "remoteip": {
     "type": "string"
    },
    "response": {
     "maxLength": 2048,
     "type": "string"
    },
    "secret": {
     "maxLength": 128,
     "type": "string"
    }
   },
   "required": [
    "secret",
    "response"
   ],
   "type": "object"
  },
  "response:siteverify": {
   "properties": {
    "action": {
     "type": "string"
    },
    "cdata": {
     "type": "string"
    },
    "challenge_ts": {
     "format": "date-time",
     "type": "string"
    },
    "error-codes": {
     "items": {
      "enum": [
       "missing-input-secret",
       "invalid-input-secret",
       "missing-input-response",
       "invalid-input-response",
       "bad-request",
       "timeout-or-duplicate",
       "internal-error"
      ],
      "type": "string"
     },
     "type": "array"
    },
    "hostname": {
     "type": "string"
    },
    "messages": {
     "type": "array"
    },
    "metadata": {
     "properties": {
      "ephemeral_id": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "success": {
     "type": "boolean"
    }
   },
   "required": [
    "success",
    "error-codes"
   ],
   "type": "object"
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "x-roots": {
  "request:siteverify": "POST /turnstile/v0/siteverify (form fields)",
  "response:siteverify": "the siteverify answer"
 },
 "x-vendor": {
  "docs": [
   "https://developers.cloudflare.com/turnstile/get-started/server-side-validation/"
  ],
  "kind": "documented",
  "provider": "turnstile",
  "title": "Cloudflare Turnstile siteverify"
 }
}
