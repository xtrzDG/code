# Assistant Workshop — environment variables.
# Names follow the concept (section 14) where it names them. Copy to .env and
# fill in; never commit real secrets. Comments stay on their own lines: Docker
# Compose, `docker run --env-file` and Render read this format as is.

# --- Runtime ---------------------------------------------------------------
# development | test | production
APP_ENV=development
# public https origin, used for webhooks and the widget
APP_BASE_URL=
# public address of the owner cabinet, e.g. https://cabinet.example.com;
# Google Calendar and the payment page send owners back there (default
# outside production: http://localhost:3000)
CABINET_BASE_URL=
# comma-separated cabinet origins, e.g. https://cabinet.example.com
CORS_ALLOWED_ORIGINS=
# Postgres in the EU; empty = in-memory storage (tests, demos)
DATABASE_URL=
# encrypts channel tokens (Fernet key or any long secret)
ENCRYPTION_KEY=

# --- Language model (concept: OpenAI gpt-5-mini in an EU data-residency project)
# openai | anthropic | scripted
LLM_PROVIDER=openai
# default: gpt-5-mini (openai), claude-opus-5-5 (anthropic)
LLM_MODEL_ID=
# model of the autotest customer and judge
LLM_JUDGE_MODEL_ID=
# minimal | low | medium | high
LLM_CHAT_EFFORT=low
LLM_JUDGE_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TOOL_ROUND_LIMIT=8
# seconds one model call of a customer chat may take; it is retried once
LLM_CALL_TIMEOUT_SECONDS=25
# read by the OpenAI SDK
OPENAI_API_KEY=
# project with EU data residency
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
# only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AUTOTEST_TURN_LIMIT=4

# --- Sign-in ---------------------------------------------------------------
OTP_LIFETIME_SECONDS=600
OTP_MAX_FAILED_ATTEMPTS=5
# Every code is a paid SMS, WhatsApp or Telegram message: caps per number or
# e-mail, per client address and in total, each per hour (429 when reached)
OTP_SENDS_PER_DESTINATION_PER_HOUR=5
OTP_SENDS_PER_IP_PER_HOUR=10
# platform caps: codes to new phones and e-mails in total, to the new phones
# of one country, and (a budget of their own) to verified users; the platform
# admins get an e-mail (and Sentry an event) when one is reached
OTP_SENDS_PER_HOUR=300
OTP_SENDS_PER_COUNTRY_PER_HOUR=100
OTP_SENDS_TO_VERIFIED_USERS_PER_HOUR=300
# code checks per client address in 10 minutes (each code allows OTP_MAX_FAILED_ATTEMPTS)
OTP_VERIFIES_PER_IP_PER_10_MINUTES=20
# phones of these countries need the bot check (empty: none); default: small
# Pacific territories and some African networks abused for SMS pumping
OTP_HIGH_RISK_COUNTRIES=CF,CK,ER,GN,GW,KI,KM,LR,MR,NR,NU,PG,SB,SL,SO,ST,TD,TK,TL,TV,VU
# comma-separated E.164 starts that never get a code, on top of premium-rate,
# shared-cost and satellite numbers (always refused), e.g. +4470,+882
OTP_DENIED_PHONE_PREFIXES=
# Cloudflare Turnstile bot check of risky code requests (new destination, busy
# address, half a cap used, high-risk country); off unless both are set
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# development/test only (default there: true): channels without a provider log the code; refused in production
OTP_LOG_CODES=
SESSION_LIFETIME_SECONDS=2592000
# comma-separated; these users get the /admin area
PLATFORM_ADMIN_EMAILS=
# comma-separated E.164 numbers
PLATFORM_ADMIN_PHONE_NUMBERS=

# --- Login codes -----------------------------------------------------------
# One provider per channel. A phone gets its code through the first channel
# of its country's list (SMS, WhatsApp, Telegram) that has a provider; when a
# provider fails, the next one is tried. E-mail sign-in needs SMTP. Configure
# a provider completely or not at all (a half-configured one stops the start).
# In production with no provider nobody can sign in: the API logs an error.
# SMS: Twilio Programmable Messaging
# AC... (Twilio console, Account info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 number or alphanumeric sender id where the country allows it
TWILIO_FROM_NUMBER=
# MG...; picks the sender per country, used instead of TWILIO_FROM_NUMBER
TWILIO_MESSAGING_SERVICE_SID=
# Telegram: Telegram Gateway API (gateway.telegram.org), paid per delivered code
TELEGRAM_GATEWAY_API_TOKEN=
# WhatsApp: Cloud API "authentication" template with a copy-code button
# platform number that sends the codes
WHATSAPP_OTP_PHONE_NUMBER_ID=
# default: WHATSAPP_SYSTEM_USER_TOKEN
WHATSAPP_OTP_ACCESS_TOKEN=
# approved template name, e.g. login_code
WHATSAPP_OTP_TEMPLATE=
# approved translations, comma-separated (en,ru,ka,pt_BR); the first is the fallback
WHATSAPP_OTP_TEMPLATE_LANGUAGES=en
# E-mail: any SMTP server (Mailgun EU, Postmark, Amazon SES, a mailbox)
SMTP_HOST=
# default: 587 (starttls), 465 (ssl), 25 (none)
SMTP_PORT=
# starttls | ssl | none (none only for a local test server)
SMTP_SECURITY=starttls
# together with SMTP_PASSWORD when the server needs a login
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. Assistant Workshop <no-reply@example.com>
SMTP_FROM=

# --- Countries, data, compliance ------------------------------------------
# confirm with a lawyer; empty disables
RESTRICTED_COUNTRY_CODES=CU,IR,KP,SY
DEFAULT_DATA_REGION=eu
RECORDING_RETENTION_DAYS=90
# call recordings kept on this server (ElevenLabs keeps its own)
RECORDINGS_DIRECTORY=var/recordings
CONTACT_MESSAGE_LIMIT_PER_HOUR=60
DPA_DOCUMENT_VERSION=2026-10-01

# --- Voice (ElevenLabs Agents) and numbers (Zadarma) ----------------------
ELEVENLABS_API_KEY=
# HMAC secret of the post-call webhook; also keys the per-business tool secrets
ELEVENLABS_WEBHOOK_SECRET=
# EU data residency (required in production)
ELEVENLABS_API_BASE_URL=https://api.eu.residency.elevenlabs.io
# true allows another ElevenLabs host in production
ELEVENLABS_ALLOW_NON_EU_REGION=false
# not read by the code yet: the assistant's number is bought in Zadarma by hand
# and entered in the cabinet (Channels, phone)
ZADARMA_API_KEY=
ZADARMA_API_SECRET=

# --- Meta (WhatsApp Cloud API, Instagram, Messenger) ----------------------
# not read by the code yet
META_APP_ID=
# signs the webhooks Meta sends (X-Hub-Signature-256)
META_APP_SECRET=
# any random string; Meta repeats it when the webhook address is registered
META_VERIFY_TOKEN=
# opens the WhatsApp numbers of businesses and of the platform, sends messages
WHATSAPP_SYSTEM_USER_TOKEN=
# platform WhatsApp number that notifies staff
WHATSAPP_NOTIFICATION_PHONE_NUMBER_ID=
# approved template with one body parameter, e.g. staff_notification
WHATSAPP_NOTIFICATION_TEMPLATE=
# approved booking reminder template of each business number; body parameters: business, date, time, name
WHATSAPP_REMINDER_TEMPLATE=

# --- Telegram (platform bot for staff notifications) ----------------------
TELEGRAM_PLATFORM_BOT_TOKEN=

# --- Google Calendar -------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Payments (Flitt) ------------------------------------------------------
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=

# --- Observability ---------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region
LANGFUSE_HOST=https://cloud.langfuse.com
# true writes message texts to the journal
LANGFUSE_CAPTURE_CONTENT=false
# errors of the API and the worker (EU project); empty = errors only in the log
SENTRY_DSN=
# share of API requests traced in Sentry (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.05
# name of the deployed build in error reports and worker heartbeats; default
# RENDER_GIT_COMMIT, which Render sets itself on every service
APP_RELEASE=
RENDER_GIT_COMMIT=
# json | text; default json in production, text elsewhere
LOG_FORMAT=

# --- Capacity --------------------------------------------------------------
# request handlers of the API running at once in threads
THREADPOOL_SIZE=64
# Postgres connections of one process (API or worker); default THREADPOOL_SIZE.
# Keep API instances x DB_POOL_SIZE + workers x DB_POOL_SIZE below the
# database's connection limit (Render basic-256mb: 100)
DB_POOL_SIZE=

# --- Background worker -----------------------------------------------------
# seconds between worker ticks (periodic jobs, and idle lane threads looking
# for queued jobs; a job queued in the same process starts at once)
WORKER_POLL_SECONDS=15
# threads per lane in each worker process: customer messages (inbound),
# deliveries (outbound), other jobs (default) and autotest runs (autotests).
# Lanes left out keep these defaults; 1 to 64 each. Any number of worker
# processes may run side by side (jobs are claimed with a lease).
WORKER_LANE_CONCURRENCY=inbound=8,outbound=4,default=2,autotests=2
# auto | true | false: run the worker inside the API process.
# auto = on only with APP_ENV=development and an empty DATABASE_URL (in-memory
# data is invisible to a separate worker); true is refused in production,
# where workers run as their own service (`workshop worker`)
EMBEDDED_WORKER=auto

# --- Demo data (development only) ----------------------------------------
# true: at startup the API fills an empty instance, once, with demo
# businesses (a Tbilisi restaurant and a Berlin beauty salon with a month of
# conversations, bookings, leads and handoffs). Sign in as +995 555 00 00 01
# or demo@example.com; the login code is printed in the API log. Refused in
# production.
SEED_DEMO_DATA=false
