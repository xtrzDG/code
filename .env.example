# Assistant Workshop — environment variables.
# Names follow the concept (section 14) where it names them. Copy to .env and
# fill in; never commit real secrets.

# --- Runtime ---------------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_BASE_URL=                       # public https origin, used for webhooks and the widget
CORS_ALLOWED_ORIGINS=               # comma-separated cabinet origins, e.g. https://cabinet.example.com
DATABASE_URL=                       # Postgres in the EU; empty = in-memory storage (tests, demos)
ENCRYPTION_KEY=                     # encrypts channel tokens (Fernet key or any long secret)

# --- Language model (concept: OpenAI gpt-5-mini in an EU data-residency project)
LLM_PROVIDER=openai                 # openai | anthropic | scripted
LLM_MODEL_ID=                       # default: gpt-5-mini (openai), claude-opus-5-5 (anthropic)
LLM_JUDGE_MODEL_ID=                 # model of the autotest customer and judge
LLM_CHAT_EFFORT=low                 # minimal | low | medium | high
LLM_JUDGE_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TOOL_ROUND_LIMIT=8
OPENAI_API_KEY=                     # read by the OpenAI SDK
OPENAI_PROJECT_ID=                  # project with EU data residency
OPENAI_BASE_URL=https://eu.api.openai.com/v1
ANTHROPIC_API_KEY=                  # only when LLM_PROVIDER=anthropic
AUTOTEST_TURN_LIMIT=4

# --- Sign-in ---------------------------------------------------------------
OTP_LIFETIME_SECONDS=600
OTP_MAX_FAILED_ATTEMPTS=5
OTP_LOG_CODES=                      # default true outside production: codes are logged, not sent
SESSION_LIFETIME_SECONDS=2592000
PLATFORM_ADMIN_EMAILS=              # comma-separated; these users get the /admin area
PLATFORM_ADMIN_PHONE_NUMBERS=       # comma-separated E.164 numbers

# --- Countries, data, compliance ------------------------------------------
RESTRICTED_COUNTRY_CODES=CU,IR,KP,SY   # confirm with a lawyer; empty disables
DEFAULT_DATA_REGION=eu
RECORDING_RETENTION_DAYS=90
CONTACT_MESSAGE_LIMIT_PER_HOUR=60
DPA_DOCUMENT_VERSION=2026-10-01

# --- Voice (ElevenLabs Agents) and numbers (Zadarma) ----------------------
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ZADARMA_API_KEY=
ZADARMA_API_SECRET=

# --- Meta (WhatsApp Cloud API, Instagram, Messenger) ----------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_SYSTEM_USER_TOKEN=

# --- Telegram (platform bot for staff notifications) ----------------------
TELEGRAM_PLATFORM_BOT_TOKEN=

# --- Google Calendar -------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Payments (Flitt) ------------------------------------------------------
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=

# --- Observability ---------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # EU region
LANGFUSE_CAPTURE_CONTENT=false             # true writes message texts to the journal
SENTRY_DSN=

# --- Background worker -----------------------------------------------------
WORKER_POLL_SECONDS=15
