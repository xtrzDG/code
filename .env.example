# Assistant Workshop — environment variables.
# Names follow the concept (section 14) where it names them. Copy to .env and
# fill in; never commit real secrets. Comments stay on their own lines: Docker
# Compose, `docker run --env-file` and Render read this format as is.

# --- Runtime ---------------------------------------------------------------
# development | test | production
APP_ENV=development
# public https origin, used for webhooks and the widget
APP_BASE_URL=
# public address of the owner cabinet, e.g. https://cabinet.example.com;
# Google Calendar and the payment page send owners back there (default
# outside production: http://localhost:3000)
CABINET_BASE_URL=
# comma-separated cabinet origins, e.g. https://cabinet.example.com
CORS_ALLOWED_ORIGINS=
# Postgres in the EU; empty = in-memory storage (tests, demos)
DATABASE_URL=
# the cabinet's live updates and the worker's job wake-ups LISTEN on this
# direct (session) Postgres connection; set it only when DATABASE_URL goes
# through a transaction
# pooler (PgBouncer, Supavisor port 6543); empty = DATABASE_URL
LIVE_EVENTS_DATABASE_URL=
# encrypts channel tokens (Fernet key or any long secret)
ENCRYPTION_KEY=
# key rotation: the keys newest first, comma-separated; ENCRYPTION_KEY follows
# as the oldest. The first key seals and signs everything new, the others only
# open what they sealed until the admin's re-encryption moved it
# (docs/operations/backup-restore.md, "Key rotation"); empty = ENCRYPTION_KEY
ENCRYPTION_KEYS=

# --- Language model (concept: OpenAI gpt-5-mini in an EU data-residency project)
# openai | anthropic | scripted
LLM_PROVIDER=openai
# default: gpt-5-mini (openai), claude-opus-5-5 (anthropic)
LLM_MODEL_ID=
# model of the autotest customer and judge
LLM_JUDGE_MODEL_ID=
# model of the call summaries for staff and of the conversation summaries
# the assistant remembers customers by (a cheap one, e.g. gpt-5-nano);
# default: LLM_MODEL_ID
LLM_SUMMARY_MODEL_ID=
# minimal | low | medium | high
LLM_CHAT_EFFORT=low
LLM_JUDGE_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TOOL_ROUND_LIMIT=8
# seconds one model call of a customer chat may take; it is retried once
LLM_CALL_TIMEOUT_SECONDS=25
# model calls one process (API instance or worker) makes at once; a call
# beyond waits up to LLM_CALL_TIMEOUT_SECONDS for a free place, then the
# reply goes to a colleague. Keep it below THREADPOOL_SIZE.
LLM_MAX_CONCURRENCY=32
# read by the OpenAI SDK
OPENAI_API_KEY=
# project with EU data residency
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
# only when LLM_PROVIDER=anthropic, or for the fallback model below
ANTHROPIC_API_KEY=
# --- Fast, resilient replies in the messaging channels
# model of the other provider a chat turn is rerun on when its own model's
# provider fails or its circuit is open (5 failures in 60 s, half-open after
# 30 s). Default: claude-sonnet-5-5 with LLM_PROVIDER=openai (needs
# ANTHROPIC_API_KEY), gpt-5-mini with anthropic (needs OPENAI_API_KEY);
# "off" turns failover off
LLM_FALLBACK_MODEL_ID=
# quiet seconds after a customer's latest message before the worker answers,
# so quick messages in a row get one reply (0: answer each at once)
MESSAGE_COALESCE_SECONDS=3
# seconds after a customer's first unanswered message when a still-running
# turn sends a short "one moment" in the customer's language (once)
CHAT_TURN_DEADLINE_SECONDS=20
# --- Reply guard beyond numbers
# cheap model that checks the policy and availability claims of a reply
# ("parking is free", "we take dogs") against the facts and tool results,
# asked only when a reply makes such a claim. Default: gpt-5-nano with
# LLM_PROVIDER=openai, claude-haiku-4-5 with anthropic, none with scripted;
# "off" turns the claim check off
LLM_VERIFIER_MODEL_ID=
# messages that look like prompt injection one contact may send in a day
# before the assistant answers with the limit notice once and then stays
# silent until the day passes
INJECTION_FLAG_LIMIT=3
# --- Customer voice notes and photos (WhatsApp, Telegram, Messenger, Instagram)
# speech-to-text model of OpenAI's EU project (OPENAI_API_KEY, OPENAI_BASE_URL),
# also with LLM_PROVIDER=anthropic; with scripted, voice notes get a polite
# request to write instead
LLM_TRANSCRIBE_MODEL=gpt-4o-transcribe
# largest voice note and photo downloaded, in bytes; longest voice note
# transcribed, in seconds. Larger or longer ones get the request to write.
MEDIA_MAX_VOICE_BYTES=16777216
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_VOICE_SECONDS=300
AUTOTEST_TURN_LIMIT=4
# plays of each launch-critical autotest scenario (prices, bookings, the
# owner's checks, the attacks); it passes only when every play passed
AUTOTEST_CRITICAL_SAMPLES=2
# --- Quality of real conversations
# nightly judge of real conversations (LLM_JUDGE_MODEL_ID): the share of the
# day's conversations it scores (0 turns it off), at most this many of one
# business, and at most this much model cost a night in US cents
QUALITY_SAMPLE_PERCENT=5
QUALITY_SAMPLE_PER_BUSINESS=20
QUALITY_SAMPLE_BUDGET_CENTS=500
# true: the assistant's own model (LLM_MODEL_ID) judges the nightly sample, so
# real conversations reach no other provider. Set false for the other
# provider's judge (LLM_JUDGE_MODEL_ID) only once the sub-processor list
# covers it (its 30-day owners' notice has run); production refuses to start
# otherwise
QUALITY_SAMPLING_JUDGE_SAME_PROVIDER=true
# milliseconds the scripted model (LLM_PROVIDER=scripted) waits before each
# answer, as a real provider would; load tests (perf/k6) set it, 0 elsewhere
SCRIPTED_LLM_LATENCY_MS=0

# --- Sign-in ---------------------------------------------------------------
OTP_LIFETIME_SECONDS=600
OTP_MAX_FAILED_ATTEMPTS=5
# Every code is a paid SMS, WhatsApp or Telegram message: caps per number or
# e-mail, per client address and in total, each per hour (429 when reached)
OTP_SENDS_PER_DESTINATION_PER_HOUR=5
OTP_SENDS_PER_IP_PER_HOUR=10
# platform caps: codes to new phones and e-mails in total, to the new phones
# of one country, and (a budget of their own) to verified users; the platform
# admins get an e-mail (and Sentry an event) when one is reached
OTP_SENDS_PER_HOUR=300
OTP_SENDS_PER_COUNTRY_PER_HOUR=100
OTP_SENDS_TO_VERIFIED_USERS_PER_HOUR=300
# code checks per client address in 10 minutes (each code allows OTP_MAX_FAILED_ATTEMPTS)
OTP_VERIFIES_PER_IP_PER_10_MINUTES=20
# phones of these countries need the bot check (empty: none); default: small
# Pacific territories and some African networks abused for SMS pumping
OTP_HIGH_RISK_COUNTRIES=CF,CK,ER,GN,GW,KI,KM,LR,MR,NR,NU,PG,SB,SL,SO,ST,TD,TK,TL,TV,VU
# comma-separated E.164 starts that never get a code, on top of premium-rate,
# shared-cost and satellite numbers (always refused), e.g. +4470,+882
OTP_DENIED_PHONE_PREFIXES=
# Cloudflare Turnstile bot check of risky code requests (new destination, busy
# address, half a cap used, high-risk country); off unless both are set
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# development/test only (default there: true): channels without a provider log the code; refused in production
OTP_LOG_CODES=
SESSION_LIFETIME_SECONDS=2592000
# a session unused this long ends by itself (owners and staff; 300..31536000)
SESSION_IDLE_TIMEOUT_SECONDS=604800
# platform admins: a session unused for 12 hours ends, and any ends after a day
ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=43200
ADMIN_SESSION_LIFETIME_SECONDS=86400
# comma-separated; only bootstrap the admin team: the first of these people to
# sign in becomes its first SUPER admin, who adds everyone else on the Team page
PLATFORM_ADMIN_EMAILS=
# comma-separated E.164 numbers (bootstrap, as above)
PLATFORM_ADMIN_PHONE_NUMBERS=
# Two-factor sign-in: sensitive actions (exports, erasures, team changes,
# connecting a channel, admin actions) need a sign-in or a fresh code within
# this many seconds (60..86400)
STEP_UP_MAX_AGE_SECONDS=600
# the name authenticator apps show next to the account
MFA_ISSUER_NAME=Assistant Workshop

# --- Login codes -----------------------------------------------------------
# One provider per channel. A phone gets its code through the first channel
# of its country's list (SMS, WhatsApp, Telegram) that has a provider; when a
# provider fails, the next one is tried. E-mail sign-in needs SMTP. Configure
# a provider completely or not at all (a half-configured one stops the start).
# In production with no provider nobody can sign in: the API logs an error.
# SMS: Twilio Programmable Messaging
# AC... (Twilio console, Account info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 number or alphanumeric sender id where the country allows it
TWILIO_FROM_NUMBER=
# MG...; picks the sender per country, used instead of TWILIO_FROM_NUMBER
TWILIO_MESSAGING_SERVICE_SID=
# Telegram: Telegram Gateway API (gateway.telegram.org), paid per delivered code
TELEGRAM_GATEWAY_API_TOKEN=
# WhatsApp: Cloud API "authentication" template with a copy-code button
# platform number that sends the codes
WHATSAPP_OTP_PHONE_NUMBER_ID=
# default: WHATSAPP_SYSTEM_USER_TOKEN
WHATSAPP_OTP_ACCESS_TOKEN=
# approved template name, e.g. login_code
WHATSAPP_OTP_TEMPLATE=
# approved translations, comma-separated (en,ru,ka,pt_BR); the first is the fallback
WHATSAPP_OTP_TEMPLATE_LANGUAGES=en
# E-mail: any SMTP server (Mailgun EU, Postmark, Amazon SES, a mailbox)
SMTP_HOST=
# default: 587 (starttls), 465 (ssl), 25 (none)
SMTP_PORT=
# starttls | ssl | none (none only for a local test server)
SMTP_SECURITY=starttls
# together with SMTP_PASSWORD when the server needs a login
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. Assistant Workshop <no-reply@example.com>
SMTP_FROM=

# --- Countries, data, compliance ------------------------------------------
# confirm with a lawyer; empty disables
RESTRICTED_COUNTRY_CODES=CU,IR,KP,SY
DEFAULT_DATA_REGION=eu
RECORDING_RETENTION_DAYS=90
# call recordings kept on this server in development (RECORDINGS_STORAGE=local)
RECORDINGS_DIRECTORY=var/recordings
# where the platform keeps call recordings: local (files under
# RECORDINGS_DIRECTORY, one server; development) or s3 (S3-compatible object
# storage in the EU, every recording encrypted with its business's key derived
# from ENCRYPTION_KEY; a finished call's recording moves there from ElevenLabs)
RECORDINGS_STORAGE=local
# with s3: the EU endpoint (https://s3.eu-central-1.amazonaws.com,
# https://<account>.eu.r2.cloudflarestorage.com, https://fsn1.your-objectstorage.com),
# its signing region (eu-central-1; auto on R2; fsn1 on Hetzner), a private
# bucket without versioning, and a key that may only read, write and delete in it
RECORDINGS_S3_ENDPOINT_URL=
RECORDINGS_S3_REGION=
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_ACCESS_KEY_ID=
RECORDINGS_S3_SECRET_ACCESS_KEY=
CONTACT_MESSAGE_LIMIT_PER_HOUR=60
DPA_DOCUMENT_VERSION=2026-10-06
# key of the suppression list (customers who sent STOP, kept as HMAC digests
# through erasure); set once and never change it, or listed customers are
# forgotten. Empty: derived from ENCRYPTION_KEY (a key rotation forgets them)
SUPPRESSION_LIST_KEY=
# how long a one-time download link of a full business export works, in
# minutes (1..10; DPA section 9 promises 10 at most). The archive is kept a day
# and downloaded at most three times, each time through a new link
EXPORT_DOWNLOAD_LINK_MINUTES=10

# --- Spend guard, call caps and generic API limits -------------------------
# a business's daily spend limits as multiples of its plan's planned daily
# provider cost (planned_provider_costs.py; Chat: about $0.72 a day). Past the
# soft one its assistant answers on a cheaper model, past the hard one it only
# takes messages for the team until its midnight; owners and the platform team
# (PLATFORM_ALERT_*) are told once. The platform team sets a client's own
# limits with PUT /v1/admin/clients/{business_id}/spend-limits
SPEND_SOFT_LIMIT_MULTIPLE=5
SPEND_HARD_LIMIT_MULTIPLE=15
# the cheaper model past the soft limit; empty = the assistant provider's small
# model (gpt-5-nano, claude-haiku-4-5). Another provider's model is ignored
SPEND_SOFT_LIMIT_MODEL_ID=
# whole US dollars the platform plans to spend on providers in a UTC day; the
# spend_budget alert fires at 80 %. Empty = no budget alert
PLATFORM_DAILY_SPEND_BUDGET_USD=
# the voice agent ends a call at this length and after this much silence
# (seconds; written into each ElevenLabs agent when it is created or updated)
CALL_MAX_DURATION_SECONDS=600
CALL_SILENCE_END_SECONDS=30
# generic request limits per sliding minute (429 with Retry-After): a
# signed-in person, their data exports, and a client address without a token
# (the website chat, webhooks and the landing demos keep their own limits)
API_REQUESTS_PER_USER_PER_MINUTE=600
API_EXPORTS_PER_USER_PER_MINUTE=30
API_REQUESTS_PER_IP_PER_MINUTE=120

# --- Voice (ElevenLabs Agents) and numbers (Zadarma) ----------------------
ELEVENLABS_API_KEY=
# HMAC secret of the post-call webhook; also keys the per-business tool secrets
ELEVENLABS_WEBHOOK_SECRET=
# EU data residency (required in production)
ELEVENLABS_API_BASE_URL=https://api.eu.residency.elevenlabs.io
# true allows another ElevenLabs host in production
ELEVENLABS_ALLOW_NON_EU_REGION=false
# the assistant's number is bought in Zadarma by hand and entered in the
# cabinet (Channels, phone); ZADARMA_API_KEY is not read by the code yet
ZADARMA_API_KEY=
# signs the PBX call notifications (POST /v1/telephony/zadarma/notifications):
# callers who did not get through are texted back and reported to staff
ZADARMA_API_SECRET=

# --- Meta (WhatsApp Cloud API, Instagram, Messenger) ----------------------
# not read by the code yet
META_APP_ID=
# signs the webhooks Meta sends (X-Hub-Signature-256)
META_APP_SECRET=
# any random string; Meta repeats it when the webhook address is registered
META_VERIFY_TOKEN=
# opens the WhatsApp numbers of businesses and of the platform, sends messages
WHATSAPP_SYSTEM_USER_TOKEN=
# platform WhatsApp number that notifies staff
WHATSAPP_NOTIFICATION_PHONE_NUMBER_ID=
# approved template with one body parameter, e.g. staff_notification
WHATSAPP_NOTIFICATION_TEMPLATE=
# approved booking reminder template of each business number; body parameters: business, date, time, name
WHATSAPP_REMINDER_TEMPLATE=
# approved utility template of the platform number for owners' summaries; body parameters: business, summary, link
WHATSAPP_OWNER_REPORT_TEMPLATE=

# --- Telegram (platform bot for staff notifications) ----------------------
TELEGRAM_PLATFORM_BOT_TOKEN=

# --- Staff notifications on cabinet devices (Web Push) ---------------------
# All three or none (off). Staff e-mail and SMS notifications use the SMTP_*
# and TWILIO_* providers of login codes.
# generate the pair once: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# who push services may contact: mailto:ops@example.com or https://...
WEB_PUSH_VAPID_SUBJECT=

# --- Google Calendar -------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Payments (Flitt) ------------------------------------------------------
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=

# --- The seller on invoices and its VAT -------------------------------------
# The platform's registered name, tax number, address (\n between lines) and
# billing e-mail, printed on every invoice and receipt PDF.
SELLER_LEGAL_NAME=Assistant Workshop
SELLER_TAX_ID=
SELLER_ADDRESS=
SELLER_EMAIL=
# the country whose VAT rules apply (ISO code) and the time zone of invoice
# dates and of the year invoice numbers count in
SELLER_COUNTRY_CODE=GE
SELLER_TIME_ZONE=Asia/Tbilisi
# invoice numbers: <series>-<year>-<number>, e.g. AW-2026-000042
SELLER_INVOICE_SERIES=AW
# true once registered for VAT (needs SELLER_TAX_ID): Georgian buyers then pay
# 18 % on top, buyers abroad none (a reverse-charge note for businesses)
PLATFORM_VAT_REGISTERED=false

# --- Public site: landing-page demos and legal pages -------------------------
# Demo businesses visitors of the landing page chat with (ids, comma
# separated, one per main niche). Every turn is a sandbox turn: no real
# booking, no staff alert, nothing billed. Empty: in development the
# SEED_DEMO_DATA businesses answer; in production the landing page shows a
# sample conversation instead of the live demo.
PUBLIC_DEMO_BUSINESS_IDS=
# messages every visitor together may send the demos in one hour (1-100000),
# the bound of the model spend the public demo can cause
PUBLIC_DEMO_MESSAGES_PER_HOUR=300
# true once a lawyer has reviewed and filled the legal texts (docs/legal):
# until then /privacy, /terms, /dpa, /security and /contact say "draft"
LEGAL_TEXTS_FINAL=false

# --- Observability ---------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region
LANGFUSE_HOST=https://cloud.langfuse.com
# true writes message texts to the journal
LANGFUSE_CAPTURE_CONTENT=false
# true keeps phone numbers and e-mail addresses in the journal's texts
# (by default they are replaced with [phone] and [email])
LANGFUSE_RAW_TEXT=false
# errors of the API and the worker (EU project); empty = errors only in the log
SENTRY_DSN=
# share of API requests traced in Sentry (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.05
# name of the deployed build in error reports and worker heartbeats; default
# RENDER_GIT_COMMIT, which Render sets itself on every service
APP_RELEASE=
RENDER_GIT_COMMIT=
# json | text; default json in production, text elsewhere
LOG_FORMAT=

# --- Platform alerts (docs/operations/slo.md) -----------------------------
# Telegram chats the platform bot posts the alerts to (chat ids, comma-
# separated: an ops group with the bot as a member); needs
# TELEGRAM_PLATFORM_BOT_TOKEN. Without chats or e-mails the alerts are only
# logged and shown on the admin system page
PLATFORM_ALERT_TELEGRAM_CHAT_IDS=
# e-mail addresses that get the alerts too (over SMTP_*), comma-separated
PLATFORM_ALERT_EMAILS=
# minutes before a firing alert is sent again while it still fires (5..1440)
PLATFORM_ALERT_COOLDOWN_MINUTES=60

# --- Help and support (the cabinet's account menu) -------------------------
# How owners reach a person at the platform: a WhatsApp number in E.164
# (+995322000000; spaces and dashes are fine), a Telegram username (with or
# without "@") and an e-mail address. A contact left empty is not offered;
# the help center (docs/help) and the status page work without them
SUPPORT_WHATSAPP=
SUPPORT_TELEGRAM=
SUPPORT_EMAIL=

# --- Capacity --------------------------------------------------------------
# docs/operations/capacity.md. Request handlers of the API running at once in
# threads; keep it above DB_POOL_SIZE (most requests hold a connection for a
# moment, and a request waiting for one beats a refused one)
THREADPOOL_SIZE=64
# Postgres connections of one process (API or worker); default half of
# THREADPOOL_SIZE. During a deploy old and new instances run together:
# 2 x (API instances x (DB_POOL_SIZE + 1) + workers x (DB_POOL_SIZE + 1)) plus
# the backup and the migration must stay below the database's connection
# limit (Render basic-256mb: 100; tests/platform/test_connection_budget.py)
DB_POOL_SIZE=
# connections a process keeps open when idle; others idle for
# DB_POOL_MAX_IDLE_SECONDS (10 to 86400) are closed, so a burst's peak does
# not stay open
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_IDLE_SECONDS=300
# owners' test chats one API process answers at once (1 to 64); one more
# gets 429 "try again in a few seconds" instead of a request thread
TEST_CHAT_MAX_CONCURRENCY=4

# --- Off-site backups and the restore drill --------------------------------
# docs/operations/backup-restore.md. `workshop backup` (a daily Render cron)
# dumps DATABASE_URL in one snapshot, encrypts it with age and uploads it to
# an EU bucket of another provider; `workshop restore-check` restores the
# newest archive into a throwaway database and checks it. The bucket: its EU
# endpoint, signing region, name (versioning on) and a key that may put,
# list, get and delete under the prefix; empty = no backups
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# the archives' folder in the bucket; retention never touches anything else
BACKUP_S3_PREFIX=workshop/
# age public keys (age1..., from `age-keygen`), comma-separated: the drill's
# key and the offline escrow key; required with a bucket
BACKUP_AGE_PUBLIC_KEY=
# the restore drill's private key (AGE-SECRET-KEY-1...); only where the drill
# runs (GitHub Actions secret), never on the production services
BACKUP_AGE_IDENTITY=
# retention: the newest backup of each of the last N days and months
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
# the drill fails when the newest backup is older than this
BACKUP_MAX_AGE_HOURS=26
# the drill's throwaway Postgres server: a role that may create databases,
# never production's server
RESTORE_CHECK_DATABASE_URL=
# pg_dump and pg_restore from this directory (e.g. /usr/lib/postgresql/17/bin);
# empty = the PATH
POSTGRES_CLIENT_BIN_DIRECTORY=

# --- Background worker -----------------------------------------------------
# seconds between worker ticks (periodic jobs, and idle lane threads looking
# for queued jobs). A queued job wakes the workers at once (Postgres NOTIFY
# on the channel workshop_jobs, received over LIVE_EVENTS_DATABASE_URL or
# DATABASE_URL); polling only catches what a dropped wake-up missed
WORKER_POLL_SECONDS=15
# the same for the customer-message lane (inbound), at most
# WORKER_POLL_SECONDS: a missed wake-up delays a reply by this much at most
WORKER_INBOUND_POLL_SECONDS=2
# threads per lane in each worker process: customer messages (inbound),
# deliveries (outbound), other jobs (default) and autotest runs (autotests).
# Lanes left out keep these defaults; 1 to 64 each. Any number of worker
# processes may run side by side (jobs are claimed with a lease).
WORKER_LANE_CONCURRENCY=inbound=8,outbound=4,default=2,autotests=2
# auto | true | false: run the worker inside the API process.
# auto = on only with APP_ENV=development and an empty DATABASE_URL (in-memory
# data is invisible to a separate worker); true is refused in production,
# where workers run as their own service (`workshop worker`)
EMBEDDED_WORKER=auto

# --- Demo data (development only) ----------------------------------------
# true: at startup the API fills an empty instance, once, with demo
# businesses (a Tbilisi restaurant and a Berlin beauty salon with a month of
# conversations, bookings, leads and handoffs). Sign in as +995 555 00 00 01
# or demo@example.com; the login code is printed in the API log. Refused in
# production.
SEED_DEMO_DATA=false
