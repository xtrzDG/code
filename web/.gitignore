# The repository's Python rules ignore every "lib/" folder; keep the app's own.
!/src/lib/

# dependencies
/node_modules

# next.js
/.next/
/out/
/build

# testing
/coverage

# typescript
*.tsbuildinfo
next-env.d.ts

# env files (.env.example is committed)
.env*
!.env.example

# misc
.DS_Store
*.pem
npm-debug.log*
.vercel

# end-to-end tests (logs, traces, reports)
/e2e/.artifacts/

# Lighthouse CI's local working folder
/.lighthouseci/
