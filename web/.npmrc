# No dependency runs install scripts (preinstall, install, postinstall):
# a compromised release cannot run code on a developer's machine, in CI or
# in the image build just by being installed. Nothing here needs them on
# Linux, macOS or Windows: Next's SWC, sharp, lightningcss, rolldown and
# unrs-resolver ship prebuilt binaries as optional platform packages
# (unrs-resolver's postinstall only fetches one when npm skipped it), and
# fsevents (macOS file watching) publishes its compiled addon. The
# project's own scripts (`npm run ...`, `npm test`) still run.
ignore-scripts=true
