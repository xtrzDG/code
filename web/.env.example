# Base URL of the Python API (server-side only; the browser never calls it directly).
# Required in production: without it every API call fails (BackendUrlMissingError).
BACKEND_URL=http://localhost:8000

# Session and language cookies are Secure in production. "false" works only for a
# production build reached over plain HTTP on this machine (http://localhost,
# 127.0.0.1 or [::1], SITE_URL unset or local), as the e2e suite and docker
# compose run it; a real deployment keeps Secure cookies whatever this says.
# COOKIE_SECURE=false

# Public address of the site (https://app.example.com): canonical links,
# hreflang alternates, the sitemap and structured data of the public pages
# name it. Unset: the address the request came in on in development; a
# production build (`next start`) then trusts only a localhost address and
# names http://localhost:3000 for any other, since a request's Host header
# is the visitor's to write. Set it in production.
# SITE_URL=https://app.example.com

# The platform's security mailbox (security@<your domain>): the first Contact
# of /.well-known/security.txt (RFC 9116), ahead of GitHub's private
# vulnerability reporting. Set it in production (the deploy smoke test checks
# it); unset, the file names GitHub only.
# SECURITY_CONTACT_EMAIL=security@example.com

# How many right-most X-Forwarded-For entries the cabinet's own proxies add
# (Render: 1). Only those are forwarded to the API for its audit log; the rest
# of the header comes from the browser. Default 0: no client address forwarded.
# TRUSTED_PROXY_HOPS=1

# Errors of the cabinet (server and browser) go to this Sentry project (EU
# region); empty: nothing is sent. Browser errors pass through the cabinet's
# own /api/monitoring, so the browser never sees the DSN.
# SENTRY_DSN=
# Share of server requests traced in Sentry, 0 to 1 (default 0.05).
# SENTRY_TRACES_SAMPLE_RATE=0.05
# Name of the deployed build in error reports (default: RENDER_GIT_COMMIT,
# which Render sets itself).
# APP_RELEASE=
# RENDER_GIT_COMMIT=
# Build time only (CI on main, docs/operations/observability.md): with a
# Sentry organization token the production build uploads its source maps to
# this organization and project for APP_RELEASE, then deletes them.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Development only: "true" serves the pseudo-locale en-XA (accented English,
# 40 % longer, in brackets) to a browser whose aw_locale cookie is en-XA, to
# find layouts that break on long Russian or Georgian texts. Never in production.
# PSEUDO_LOCALE=true
