    {
      "type": "timeseries",
      "id": 15,
      "title": "Due jobs by lane",
      "description": "Read from the database at scrape time: every instance reports the same figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
